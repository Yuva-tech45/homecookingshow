rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);

      // User Saved Recipes
      match /savedRecipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }

      // User Meal Plan
      match /mealPlan/{planId} {
        allow read, write: if isOwner(userId);
      }

      // User Grocery Checklist
      match /groceries/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community Kitchen Wall Stories
    match /communityStories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Allow incrementing/decrementing likes or updating own story
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

  }
}
